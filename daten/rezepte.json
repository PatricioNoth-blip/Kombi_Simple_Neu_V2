    {
      "id": "linsen-bolognese",
      "art": "rezept",
      "name": "Linsen-Bolognese mit Nudeln",
      "personen": 2,
      "zeit": "30–40 Min.",
      "plaetze": [
        { "kategorie": "rot", "pflicht": true, "optionen": [
          { "zutat": "bolognese-basis", "menge": 200, "einheit": "g" }
        ] },
        { "kategorie": "braun", "pflicht": true, "optionen": [
          { "zutat": "braune-linsen-trocken", "menge": 150, "einheit": "g" }
        ] },
        { "kategorie": "gelb", "pflicht": true, "optionen": [
          { "zutat": "nudeln", "menge": 180, "einheit": "g" }
        ] },
        { "kategorie": "gruen", "pflicht": false, "optionen": [
          { "zutat": "gemuesemix", "menge": 200, "einheit": "g" }
        ] }
      ],
      "grundvorrat": [],
      "weitere": [
        { "name": "Wasser oder Gemüsebrühe", "menge": [350, 450], "einheit": "ml" }
      ],
      "schritte": [
        "Linsen in Wasser oder Brühe nach Packungsangabe weich garen.",
        "Basis und, falls gewünscht, den Gemüsemix zugeben und 8–10 Min. köcheln, bis alles dampfend heiß ist.",
        "Nudeln separat kochen und mit der Sauce servieren."
      ],
      "hinweise": [
        "Die eingefrorene Basis ist bereits gewürzt."
      ]
    },
    {
      "id": "falafel-couscous-bowl",
      "art": "rezept",
      "name": "Falafel-Couscous-Bowl mit Tomatendip",
      "personen": 2,
      "zeit": "ca. 45 Min.",
      "plaetze": [
        { "kategorie": "braun", "pflicht": true, "optionen": [
          { "zutat": "kichererbsen-trocken", "menge": 150, "einheit": "g", "vorbereitung": "12–18 Std. einweichen" }
        ] },
        { "kategorie": "gelb", "pflicht": true, "optionen": [
          { "zutat": "couscous", "menge": 120, "einheit": "g" }
        ] },
        { "kategorie": "gruen", "pflicht": false, "optionen": [
          { "zutat": "paprika-zwiebel-mix", "menge": 200, "einheit": "g" }
        ] },
        { "kategorie": "rot", "pflicht": false, "hinweis": "als Dip", "optionen": [
          { "zutat": "curry-basis", "menge": 200, "einheit": "g" }
        ] }
      ],
      "grundvorrat": [
        { "zutat": "mehl", "menge": 1, "einheit": "EL" },
        { "zutat": "zwiebeln" },
        { "zutat": "knoblauch" },
        { "zutat": "gewuerze" },
        { "zutat": "gemuesebruehe" }
      ],
      "weitere": [],
      "schritte": [
        "Kichererbsen 12–18 Std. einweichen und abgießen, nicht kochen.",
        "Roh fein zerkleinern, mit Zwiebel, Knoblauch, Gewürzen und Mehl binden und kleine Falafel formen.",
        "Bei 200 °C ca. 20–25 Min. backen, dabei einmal wenden.",
        "Couscous mit heißer Brühe übergießen und quellen lassen.",
        "Falls gewünscht, Gemüse anbraten und die erhitzte Basis als Dip dazugeben."
      ],
      "hinweise": [
        "Hier ist bewusst nur „trocken“ erlaubt: Falafel gelingen nur aus eingeweichten, ungekochten Kichererbsen. Die schnelle Variante mit TK-Falafel ist „Gemüse-Couscous mit Falafel“."
      ]
    },
    {
      "id": "kichererbsen-tomaten-pasta",
      "art": "rezept",
      "name": "Kichererbsen-Tomaten-Pasta",
      "personen": 2,
      "zeit": "20 Min.",
      "plaetze": [
        { "kategorie": "rot", "pflicht": true, "optionen": [
          { "zutat": "curry-basis", "menge": 200, "einheit": "g" },
          { "zutat": "bolognese-basis", "menge": 200, "einheit": "g" }
        ] },
        { "kategorie": "braun", "pflicht": true, "optionen": [
          { "zutat": "kichererbsen-dose", "menge": 200, "einheit": "g" },
          { "zutat": "kichererbsen-gekocht", "menge": 200, "einheit": "g" }
        ] },
        { "kategorie": "gelb", "pflicht": true, "optionen": [
          { "zutat": "nudeln", "menge": 180, "einheit": "g" }
        ] }
      ],
      "grundvorrat": [],
      "weitere": [
        { "name": "Nudelwasser", "menge": [100, 150], "einheit": "ml" }
      ],
      "schritte": [
        "Nudeln kochen und etwas Nudelwasser aufheben.",
        "Basis erhitzen und die Kichererbsen zugeben. Kichererbsen aus der Dose vorher abgießen und abspülen.",
        "8–10 Min. köcheln, bei Bedarf mit Nudelwasser verdünnen.",
        "Mit den Nudeln vermengen."
      ],
      "hinweise": []
    },

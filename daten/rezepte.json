    {
      "id": "linsen-bolognese",
      "art": "rezept",
      "name": "Linsen-Bolognese mit Nudeln",
      "personen": 2,
      "zeit": "30–40 Min.",
      "plaetze": [
        { "kategorie": "rot", "pflicht": true, "optionen": [
          { "zutat": "tomatenbasis", "menge": 200, "einheit": "g" },
          { "zutat": "passierte-tomaten", "menge": 250, "einheit": "g", "hinweis": "vorher 1 Zwiebel in Öl anschwitzen und 10 Min. länger köcheln" }
        ] },
        { "kategorie": "braun", "pflicht": true, "optionen": [
          { "zutat": "braune-linsen-trocken", "menge": 150, "einheit": "g" },
          { "zutat": "braune-linsen-gekocht", "menge": 400, "einheit": "g", "hinweis": "nur erhitzen, nicht mehr garen" }
        ] },
        { "kategorie": "gelb", "pflicht": true, "optionen": [
          { "zutat": "nudeln", "menge": 180, "einheit": "g" }
        ] },
        { "kategorie": "gruen", "pflicht": false, "optionen": [
          { "zutat": "gemuesemix", "menge": 200, "einheit": "g" }
        ] }
      ],
      "grundvorrat": [
        { "zutat": "italienische-kraeuter", "menge": 1, "einheit": "TL" },
        { "zutat": "knoblauch", "menge": 1, "einheit": "Zehe" }
      ],
      "weitere": [
        { "name": "Wasser oder Gemüsebrühe (für trockene Linsen)", "menge": [350, 450], "einheit": "ml" }
      ],
      "schritte": [
        "Trockene Linsen in Wasser oder Brühe nach Packungsangabe weich garen (ca. 25–30 Min.).",
        "Basis, Knoblauch, Kräuter und, falls gewünscht, den Gemüsemix zugeben und 8–10 Min. köcheln, bis alles dampfend heiß ist.",
        "Nudeln separat kochen und mit der Sauce servieren."
      ],
      "hinweise": [
        "Die Basis ist ungewürzt – Kräuter und Knoblauch bringen die italienische Richtung."
      ]
    },
    {
      "id": "falafel-couscous-bowl",
      "art": "rezept",
      "name": "Falafel-Couscous-Bowl mit Tomatendip",
      "personen": 2,
      "zeit": "ca. 45 Min.",
      "plaetze": [
        { "kategorie": "braun", "pflicht": true, "optionen": [
          { "zutat": "kichererbsen-trocken", "menge": 150, "einheit": "g", "vorbereitung": "12–18 Std. einweichen" }
        ] },
        { "kategorie": "gelb", "pflicht": true, "optionen": [
          { "zutat": "couscous", "menge": 120, "einheit": "g" }
        ] },
        { "kategorie": "gruen", "pflicht": false, "optionen": [
          { "zutat": "paprika-zwiebel-mix", "menge": 200, "einheit": "g" }
        ] },
        { "kategorie": "rot", "pflicht": false, "hinweis": "als Dip", "optionen": [
          { "zutat": "tomatenbasis", "menge": 200, "einheit": "g" },
          { "zutat": "passierte-tomaten", "menge": 250, "einheit": "g", "hinweis": "mit etwas Zwiebel 10 Min. einköcheln" }
        ] }
      ],
      "grundvorrat": [
        { "zutat": "mehl", "menge": 1, "einheit": "EL" },
        { "zutat": "zwiebeln" },
        { "zutat": "knoblauch" },
        { "zutat": "kreuzkuemmel", "menge": 1, "einheit": "TL" },
        { "zutat": "paprikapulver", "menge": 0.5, "einheit": "TL" },
        { "zutat": "gemuesebruehe" },
        { "zutat": "zitronensaft", "menge": 1, "einheit": "EL", "optional": true }
      ],
      "weitere": [],
      "schritte": [
        "Kichererbsen 12–18 Std. einweichen und abgießen, nicht kochen.",
        "Roh fein zerkleinern, mit Zwiebel, Knoblauch, Kreuzkümmel, Paprikapulver und Mehl binden und kleine Falafel formen.",
        "Bei 200 °C ca. 20–25 Min. backen, dabei einmal wenden.",
        "Couscous mit heißer Brühe übergießen und quellen lassen.",
        "Falls gewünscht, Gemüse anbraten und die erhitzte Basis mit einer Prise Kreuzkümmel und etwas Zitronensaft als Dip dazugeben."
      ],
      "hinweise": [
        "Hier ist bewusst nur „trocken“ erlaubt: Falafel gelingen nur aus eingeweichten, ungekochten Kichererbsen. Die schnelle Variante mit TK-Falafel ist „Gemüse-Couscous mit Falafel“."
      ]
    },
